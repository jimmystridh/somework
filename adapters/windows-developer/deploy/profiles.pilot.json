{
  "build": {
    "tooling-check": {
      "command": "git --version && node --version",
      "cwd": ".",
      "timeoutMinutes": 5,
      "blockPushOnFailure": false
    },
    "sdk-install": {
      "command": "npm ci --ignore-scripts --no-audit --no-fund",
      "cwd": "sdk/typescript",
      "timeoutMinutes": 20,
      "blockPushOnFailure": true
    },
    "adm-debug": {
      "command": "powershell.exe -NoProfile -ExecutionPolicy RemoteSigned -File C:/somework/agent/adapters/windows-developer/deploy/build-adm.ps1",
      "cwd": ".",
      "timeoutMinutes": 90,
      "blockPushOnFailure": true
    }
  },
  "test": {
    "sdk-unit": {
      "command": "node --test --test-concurrency=1 $(ls test/*.test.ts | grep -vE 'tls|wake|worker')",
      "cwd": "sdk/typescript",
      "timeoutMinutes": 20,
      "blockPushOnFailure": true
    }
  },
  "encoding": {
    "legacyGlobs": [
      "**/*.cpp",
      "**/*.h",
      "**/*.rc"
    ],
    "utf8Globs": [
      "**/*.md",
      "**/*.json",
      "**/*.ts",
      "**/*.tsx"
    ],
    "blockPush": true
  }
}
