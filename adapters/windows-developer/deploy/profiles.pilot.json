{
  "build": {
    "tooling-check": {
      "command": "git --version && node --version",
      "cwd": ".",
      "timeoutMinutes": 5,
      "blockPushOnFailure": false
    },
    "sdk-install": {
      "command": "npm ci --ignore-scripts --no-audit --no-fund",
      "cwd": "sdk/typescript",
      "timeoutMinutes": 20,
      "blockPushOnFailure": true
    }
  },
  "test": {
    "sdk-unit": {
      "command": "npm test",
      "cwd": "sdk/typescript",
      "timeoutMinutes": 20,
      "blockPushOnFailure": true
    }
  },
  "encoding": {
    "legacyGlobs": [
      "**/*.cpp",
      "**/*.h",
      "**/*.rc"
    ],
    "utf8Globs": [
      "**/*.md",
      "**/*.json",
      "**/*.ts",
      "**/*.tsx"
    ],
    "blockPush": true
  }
}
