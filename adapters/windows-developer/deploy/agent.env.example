# agent.env: the settings of the Windows developer service (KEY=VALUE, no quotes needed, # starts a comment). Copy to agent.env, edit,
# and pass it to install-service.ps1 -EnvFile. No secret belongs in this file: keys and tokens are files under C:\somework\secrets.

# --- SomeWork domain ---
SOMEWORK_URL=https://somework.example.test:8443
SOMEWORK_KEY_FILE=C:\somework\secrets\agent.key.json
SOMEWORK_CA_FILE=C:\somework\secrets\ca.pem
SOMEWORK_REQUIRE_TLS=1

# --- model: the service's OWN login, never shared with another agent (refresh tokens rotate) ---
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.5
PI_STATE_DIR=C:\somework\state
PI_AUTH_FILE=C:\somework\state\auth.json
PI_CONCURRENCY=1
BUDGET_MAX_TOKENS_CAP=1000000
BUDGET_MAX_MINUTES_CAP=60
DAILY_TOKEN_LIMIT=2000000

# --- git: token for ONE repository (contents + pull requests write); it is only ever sent to the hosts listed here ---
GIT_TOKEN_FILE=C:\somework\secrets\git-token
GIT_TOKEN_HOSTS=github.com
# a fine-grained token has one owner: a token file per other owner, `owner=path` entries separated by semicolons
# GIT_TOKEN_OWNERS=jimmystridh=C:\somework\secrets\git-token-jimmystridh
GIT_PR_DRAFT=1
GIT_AUTHOR_NAME=SomeWork Windows developer
GIT_AUTHOR_EMAIL=windows-developer@somework.invalid

# --- this role ---
WINDOWS_WORKSPACE_ROOT=C:/somework/workspaces
WINDOWS_PROFILES_FILE=C:\somework\agent\profiles.json
# WINDOWS_BASH=C:\Program Files\Git\bin\bash.exe
# WINDOWS_PATH_DIRS=C:\Program Files\Git\cmd;C:\Program Files\Git\usr\bin;C:\Program Files\nodejs;C:\Windows\System32;C:\Windows
# WINDOWS_PASS_ENV=VSINSTALLDIR,DOTNET_ROOT
# WINDOWS_MAX_OUTPUT_BYTES=8388608
# After a timeout or abort, stop every process of this account that started during the command (Git Bash background children escape taskkill /T).
# Needs PI_CONCURRENCY=1 and the account must run nothing else while a job runs.
WINDOWS_SWEEP_USER=svc-somework

# --- repository skills this role may use (the repository's own, loaded at the task's ref); empty keeps the role's default ---
# SKILLS_ALLOW=style-skill,encoding-skill   (names of skills in the repository's own skill folders)
# SKILLS_OVERLAY_DIR=C:\somework\agent\skills-overlay

HEALTH_PORT=8081
# WINDOWS_HEALTH_BIND=10.10.10.45   # only when a dashboard on another machine reads /status; allow that one reader in the firewall (README)
NODE_EXE=C:\Program Files\nodejs\node.exe

# conversations: every message sent to the agent is read by the model; work runs as background jobs. All optional.
# CHAT_MODE=off                    # the agent takes no part in conversations
# APPROVERS=agent/manager,kind:human   # who may decide an approval
# CHAT_REPOSITORY_URL=https://github.com/ORG/REPO   # what an instruction works on unless it names repo:
# CHAT_TOKEN_SHARE=0.1

# Read-only logs and alerts for the agent itself (observe tools; packages/agent-kit/README.md). Needs the read-only Grafana route, the token and the CA in
# C:\somework\secrets (readable by the service account only) and the route's address in the firewall allow list.
# OBSERVE_ENABLED=1
# OBSERVE_SCOPE=own
# OBSERVE_OWN=host="<this machine's host label>",service_name="<role>"
# GRAFANA_URL=https://<observability VM private address>:9444
# GRAFANA_TOKEN_FILE=C:\somework\secrets\grafana-token
# GRAFANA_CA_FILE=C:\somework\secrets\grafana-ca.pem

# Pull request watches (docs/AGENT_FLEET.md, "Watching a pull request"): the agent asks the event hub for the events of one pull request and is woken by its CI or build
# result, reviews and comments. The token is `somework-hub watch-token agent/windows-developer` on the hub, kept in C:\somework\secrets; the hub's TLS address must be in the firewall allow list.
# WATCH_URL=https://hub.example.internal:8091
# WATCH_TOKEN_FILE=C:\somework\secrets\watch-token
# WATCH_CA_FILE=C:\somework\secrets\ca.pem

# The agent's own Slack app in Socket Mode (packages/agent-kit/README.md, "Slack"; it opens the connection to Slack, nothing listens). Needs both token files
# in C:\somework\secrets (readable by the service account only), the Slack hosts of firewall-allow.pilot.txt in the firewall allow list and at least one member id.
# SLACK_BOT_TOKEN_FILE=C:\somework\secrets\slack-bot-token      # the xoxb- bot token
# SLACK_APP_TOKEN_FILE=C:\somework\secrets\slack-app-token      # the xapp- app-level token with connections:write
# SLACK_ALLOWED_USER_IDS=U0123ABCD                              # required: the Slack member ids that may write to the agent
# SLACK_ALLOWED_CHANNELS=C0123ABCD                              # optional: channels where a mention is answered (in a thread); empty = DMs only
# SLACK_MESSAGES_PER_HOUR=30
