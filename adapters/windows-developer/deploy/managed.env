# Settings that come with every deployment from the repository (the machine's own paths and secrets stay in agent.env; these override it).
# an instruction in chat may use 600k tokens and the day's chat pool is half of the limit
DAILY_TOKEN_LIMIT=4000000
BUDGET_MAX_TOKENS_CAP=1000000
# a fine-grained token belongs to one owner: repositories of the owner `jimmystridh` use their own token file (read access for the service account only)
GIT_TOKEN_OWNERS=jimmystridh=C:\somework\secrets\git-token-jimmystridh
# a full build of the product takes hours (the job's own limit would stop it at 60 minutes), later builds are incremental in a persistent workspace
BUDGET_MAX_MINUTES_CAP=300
# bun runs the front end's install, lint and unit tests (the QA agent asks for them); the first entries are the kit's default PATH
WINDOWS_PATH_DIRS=C:\Program Files\Git\cmd;C:\Program Files\Git\usr\bin;C:\Program Files\Git\mingw64\bin;C:\Program Files\nodejs;C:\tools\bun;C:\Windows\System32;C:\Windows;C:\Windows\System32\Wbem
# plain git in the model's shell (clone, fetch, ls-remote, push of its own branches) authenticates with this role's own token files, only to GIT_TOKEN_HOSTS
WINDOWS_SHELL_GIT_AUTH=1
