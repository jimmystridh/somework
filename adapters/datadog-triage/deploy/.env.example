DATADOG_VERSION=pilot-1
SOMEWORK_URL=https://domain.example.internal:8443
DATADOG_KEY_DIR=/srv/somework-datadog-triage/keys
# Datadog site: datadoghq.eu (default), datadoghq.com, us3.datadoghq.com, us5.datadoghq.com, ap1.datadoghq.com, ap2.datadoghq.com, ddog-gov.com
DD_SITE=datadoghq.eu
# credential-free smoke test: PI_PROVIDER=faux  PI_FAUX_PLAN='["final:```json\n{\"outcome\":\"inconclusive\",\"severity\":\"info\",\"summary\":\"smoke test\",\"confidence\":\"low\",\"timeline\":[],\"evidence\":[],\"recommendedActions\":[]}\n```"]'
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.5
# cheaper model for event-driven runs while the events pool is throttled (optional): EVENTS_SMALL_MODEL=openai-codex/gpt-5.5-mini
# DD_MIN_PRIORITY=P3
# DD_MONITOR_IDS=12345,67890
# DD_TAG_FILTER=team:platform,env:prod
# DD_IGNORE_WARN=1
# DD_IGNORE_MONITORS=89853058,89667590
# DD_IGNORE_NAMES=System load is high;Pods Restarting
# DD_REQUIRE_PRIORITY=1
# DD_COOLDOWN_MINUTES=60
# DD_DAILY_CAP=20
# DD_WINDOW_MINUTES=60
# DD_TRIAGE_BUDGET_TOKENS=150000     # at most 300000
# DD_TRIAGE_BUDGET_MINUTES=10        # at most 20
# DD_SAVE_FILE_BYTES=5242880         # largest file one save=true call writes (at most 5 MB)
# DD_SAVE_TASK_BYTES=20971520        # most the saved files of one triage add up to (at most 20 MB)
# DD_RESEED_HANDLER=1                # write the shipped handler again, with these settings, as a new version (then set it back)
# SANDBOX_MEMORY=2g
# SANDBOX_CPUS=2
BUDGET_MAX_TOKENS_CAP=300000
BUDGET_MAX_MINUTES_CAP=20
DAILY_TOKEN_LIMIT=2000000
# HEALTH_BIND=10.10.10.11   # interface for the health port (default 127.0.0.1); the dashboard reads handlers and token pools from it

# chat: every agent answers direct messages with the model (questions: Datadog tools only; "instruct:" from the instructors runs a triage). All optional.
# CHAT_MODE=notice                 # the fixed notice only, no model
# CHAT_ALLOWED_SENDERS=agent/manager,kind:human
# CHAT_INSTRUCTORS=agent/manager
# CHAT_TOKEN_SHARE=0.1
# CHAT_TOKEN_CAP=40000
# CHAT_INSTRUCT_TOKENS=150000
# CHAT_INSTRUCT_MINUTES=10
