FIXER_VERSION=pilot-1
# the developer role's sandbox and egress image tag (this role reuses those images, see ../Dockerfile)
SANDBOX_VERSION=pilot-1
SOMEWORK_URL=https://domain.example.internal:8443
FIXER_KEY_DIR=/srv/somework-aikido-fixer/keys
# the ONE repository this agent fixes (clone URL). Events about issues of other repositories are dropped.
AIKIDO_REPOSITORY_URL=https://github.com/example-org/example-repository.git
AIKIDO_REGION=eu
# 0 = open real pull requests (default), 1 = open drafts. Branches are always agent/aikido-<issue>-<sha>, the default branch is never touched and nothing is merged.
GIT_PR_DRAFT=0
# credential-free smoke test: PI_PROVIDER=faux  PI_FAUX_PLAN='["final:NO_FIX: smoke test"]'
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.5
# cheaper model for event-driven runs while the events pool is throttled (optional): EVENTS_SMALL_MODEL=openai-codex/gpt-5.5-mini
# AIKIDO_MIN_SEVERITY=high
# AIKIDO_FIX_TYPES=open_source,sast,iac
# AIKIDO_DAILY_CAP=5
# AIKIDO_LEDGER_IMPORT=/run/config/past-attempts.json   # earlier attempts for the chat's account; mount the file next to checks.json (README: Chat)
# AIKIDO_MAX_ATTEMPTS_PER_ISSUE=2
# name of a profile in config/checks.json that the service runs after the model, before anything is pushed
# AIKIDO_CHECK_PROFILE=unit
# package registries the repository's code needs through the egress proxy (replaces the default list)
# EGRESS_ALLOW=github.com,*.github.com,*.githubusercontent.com,registry.npmjs.org,*.npmjs.org,api.nuget.org,*.nuget.org
BUDGET_MAX_TOKENS_CAP=500000
DAILY_TOKEN_LIMIT=2000000
# HEALTH_BIND=10.10.10.11   # interface for the health port (default 127.0.0.1); the dashboard reads handlers and token pools from it

# chat: every agent answers direct messages with the model (questions read-only; "instruct:" from the instructors runs a job). All optional.
# CHAT_MODE=notice                 # the fixed notice only, no model
# CHAT_ALLOWED_SENDERS=agent/manager,kind:human
# CHAT_INSTRUCTORS=agent/manager
# (instructions fix AIKIDO_REPOSITORY_URL; CHAT_REPOSITORY_URL is not used)
# CHAT_TOKEN_SHARE=0.1
