TRIAGE_VERSION=pilot-1
# the developer role's sandbox image (built from adapters/pi/Dockerfile --target sandbox): the same tag the other stacks on this host use
SANDBOX_VERSION=pilot-1
SOMEWORK_URL=https://domain.example.internal:8443
TRIAGE_KEY_DIR=/srv/somework-jira-triage/keys
# the ticket system (the same names the QA role uses; the three secret files are mounted from ./secrets)
JIRA_URL=https://jira.example.internal
# JIRA_PROJECTS=SAD                  # project keys, comma separated; events of any other project are ignored
# JIRA_CA_HOST=./config/jira-ca.pem  # only when a private CA signed the host's certificate
# JIRA_TRIAGE_LABEL=triaged-by-bot
# JIRA_NEEDS_INFO_LABEL=needs-info
# JIRA_BOT_CREATED_LABEL=created-by-bot
# JIRA_BOT_USER=svc-jira-triage      # only when the token belongs to a service account: updates made by it are the bot's own echo and start no job
# the first days on a real project: judge and record only (nothing is written to Jira, nobody is messaged); then set it to 0 and restart
TRIAGE_DRY_RUN=1
# TRIAGE_LANGUAGE=en                 # en | sv
# TRIAGE_ENRICH=1                    # 0 = do not ask the developer agent for a read-only look first
# TRIAGE_DEVELOPER_AGENT=agent/pi-agent
# TRIAGE_DEVELOPER_WAIT_MINUTES=10
# TRIAGE_REPORTER_WAIT_HOURS=48
# TRIAGE_REPORTER_POLL_MINUTES=5
# TRIAGE_MAX_ROUNDS=2
# TRIAGE_RETRY_MINUTES=2,5,15,30,60,120,240,480
# TRIAGE_MAX_ATTEMPTS=12
# TRIAGE_CREATE_TYPES=Bug,Story,Task,Improvement
# TRIAGE_DAILY_CAP=200
# JIRA_RESEED_HANDLER=1              # write the shipped handler again, with these settings, as a new version (then set it back)
# credential-free smoke test of the conversations: PI_PROVIDER=faux  PI_FAUX_PLAN='["final:hello"]'
PI_PROVIDER=openai-codex
# CODEX_PROXY_URL=http://PROXY_HOST:8095   # route the model through the fleet's codex-proxy (needs the agent's proxy key in secrets/pi/auth.json)
PI_MODEL=gpt-6.1-sol
# cheaper model for event-driven runs while the events pool is throttled (optional): EVENTS_SMALL_MODEL=openai-codex/gpt-6-luna
BUDGET_MAX_TOKENS_CAP=200000
BUDGET_MAX_MINUTES_CAP=15
DAILY_TOKEN_LIMIT=1000000
# Who hears how each triage job ended (one notice per ticket the handler started a job for). Default agent/manager.
# EVENTS_NOTIFY_TO=agent/manager
# HEALTH_BIND=10.10.10.11   # interface for the health port (default 127.0.0.1); the dashboard reads handlers and token pools from it (port 8085)

# the agent's own Slack app in Socket Mode (packages/agent-kit/README.md, "Slack"); the same bot token writes the direct messages to reporters
# SLACK_BOT_TOKEN_HOST=./secrets/slack-bot-token
# SLACK_APP_TOKEN_HOST=./secrets/slack-app-token
# SLACK_ALLOWED_USER_IDS=U0123ABCD     # the people the Slack companion creates tickets for (member ids, comma separated)
# SLACK_ALLOWED_CHANNELS=C0123ABCD
# the agent's own Telegram bot (optional)
# TELEGRAM_TOKEN_HOST=./secrets/telegram-bot-token
# TELEGRAM_ALLOWED_USER_IDS=123456789

# chat: the Slack conversations are read by the model. All optional.
# CHAT_MODE=off                    # the agent takes no part in conversations (the triage by events still runs)
# CHAT_TOKEN_SHARE=0.3
# CHAT_INSTRUCT_TOKENS=120000
# CHAT_INSTRUCT_MINUTES=10
