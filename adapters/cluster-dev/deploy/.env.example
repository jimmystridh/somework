CLUSTER_DEV_VERSION=pilot-1
# the developer role's sandbox image tag (this role reuses that image, see Dockerfile)
SANDBOX_VERSION=pilot-1
SOMEWORK_URL=https://domain.example.internal:8443
CLUSTER_DEV_KEY_DIR=/srv/somework-cluster-dev/keys

# model: this role's own login (secrets/pi/auth.json). Credential-free smoke test: PI_PROVIDER=faux with PI_FAUX_PLAN
PI_PROVIDER=openai-codex
# CODEX_PROXY_URL=http://PROXY_HOST:8095   # route the model through the fleet's codex-proxy (needs the agent's proxy key in secrets/pi/auth.json)
PI_MODEL=gpt-5.5
# PI_ALLOWED_MODELS=

# the organisation repository (https) and the remote its pushes go to. Never origin.
CLUSTER_DEV_REPOSITORY=https://github.com/ORG/REPOSITORY
CLUSTER_DEV_GIT_REMOTE=org
# more repositories git_push may push to, name=https://host/owner/repository, comma separated; each needs ./secrets/git/git-token-<name> (a token of its own: a fine-grained token has one owner)
# CLUSTER_DEV_EXTRA_REPOSITORIES=
# 1: ask the owner before a destructive command (default: nothing is asked; only what is never allowed, a push anywhere but the listed repositories, is refused)
# CLUSTER_DEV_CONFIRM=
# 1: with CLUSTER_DEV_CONFIRM=1, the sandbox's own commands and files are asked about too (default: only commands on a machine of the cluster are)
# CLUSTER_DEV_ASK_IN_SANDBOX=
# GIT_TOKEN_EXPIRES=2027-01-31

# host_exec: name=user@address[:port], separated by commas. A host needs ./secrets/ssh/<name> (its own private key, 0600, uid 10001) and a line in ./secrets/ssh/known_hosts.
CLUSTER_DEV_HOSTS=agents=USER@AGENTS_VM_ADDRESS,services=USER@SERVICES_VM_ADDRESS,runner=USER@RUNNER_VM_ADDRESS,pve-host=root@HYPERVISOR_ADDRESS
# names and addresses that are the hypervisor: every command there asks the owner, whatever it is
CLUSTER_DEV_HYPERVISOR_HOSTS=pve-host,proxmox,HYPERVISOR_ADDRESS
# systemd units it may restart without asking, patterns with * (empty: none; docker compose stacks need no unit)
# CLUSTER_DEV_OWN_SERVICES=
# repository scripts that may run on any host (path suffixes). Empty: deploy/agents/roll-agent.sh and deploy/agents/deploy-from-ci.sh
# CLUSTER_DEV_SCRIPTS=
# CLUSTER_DEV_EXEC_TIMEOUT_SECONDS=120
# CLUSTER_DEV_EXEC_MAX_BYTES=32768

# deploy_status: the agents' health ports, name=http://address:port
CLUSTER_DEV_AGENT_URLS=developer=http://AGENTS_VM_ADDRESS:8081,reviewer=http://AGENTS_VM_ADDRESS:8082,aikido-fixer=http://AGENTS_VM_ADDRESS:8083,datadog-triage=http://AGENTS_VM_ADDRESS:8084
# CLUSTER_DEV_AGENTS_CA_HOST=./config/agents-ca.pem

# ci_pipelines and ci_logs (Woodpecker). Off while CI_URL is empty. The token goes in ./secrets/ci-token.
CI_URL=https://ci.example.internal:8443
CI_REPO=ORG/REPOSITORY
CI_TOKEN_HOST=./secrets/ci-token
# CI_CA_HOST=./config/ci-ca.pem

# observe over the whole fleet: the Viewer service account's token goes in ./secrets/grafana-token
OBSERVE_ENABLED=1
GRAFANA_URL=https://grafana.example.internal
GRAFANA_TOKEN_HOST=./secrets/grafana-token
# GRAFANA_CA_HOST=./config/grafana-ca.pem

# Telegram: how the owner talks to the agent and answers its questions. The bot token goes in ./secrets/telegram-bot-token; only these numeric user ids may write to it.
TELEGRAM_TOKEN_HOST=./secrets/telegram-bot-token
TELEGRAM_ALLOWED_USER_IDS=

# Slack: the agent's own app in Socket Mode (packages/agent-kit/README.md, "Slack"; manifest packages/agent-kit/docs/slack-app-manifest.yaml). Tokens in ./secrets/slack-bot-token and ./secrets/slack-app-token; only these member ids may write to it.
# SLACK_BOT_TOKEN_HOST=./secrets/slack-bot-token
# SLACK_APP_TOKEN_HOST=./secrets/slack-app-token
# SLACK_ALLOWED_USER_IDS=
# SLACK_ALLOWED_CHANNELS=

BUDGET_MAX_TOKENS_CAP=1000000
DAILY_TOKEN_LIMIT=8000000
# silence on an approval question is a denial after this many minutes
# CHAT_APPROVAL_MINUTES=30

# pull request watches: the event hub wakes the agent for the events of a pull request it asks about. The token comes from
# `somework-hub watch-token agent/cluster-dev` on the hub (keep it in ./secrets/watch-token); the hub's TLS port must allow this VM's address.
#WATCH_URL=https://hub.example.internal:8091
#WATCH_TOKEN_HOST=./secrets/watch-token
