# ~/.config/agent-cluster-telegram/manager.env (mode 0600)
MANAGER_SOMEWORK_URL=https://10.0.0.5:8443
MANAGER_KEY_FILE=/home/js/somework-manager/keys/manager.key.json
MANAGER_CA_FILE=/home/js/somework-pilot/pi-agent/config/ca.pem
MANAGER_COMPOSE_FILES=/home/js/agent-cluster-pi/compose.pi.yaml,/home/js/somework-manager/adapters/manager/deploy/compose.manager.yaml

# The gateway listens on the gateway address of the Pi compose network (`docker network inspect agent-cluster-pi_default`), so only
# the host and containers on that network can reach it. The container gets the same address in its URL.
MANAGER_GATEWAY_BIND=172.18.0.1
MANAGER_GATEWAY_PORT=7079
MANAGER_GATEWAY_URL=http://172.18.0.1:7079

# Policy (defaults shown)
#MANAGER_MESSAGES_PER_HOUR=60
#MANAGER_APPROVAL_TTL_MINUTES=10

# Learning about changes: `wake` (NATS + HTTP safety net) or `polling` (short HTTP lookups only)
#MANAGER_FEED=wake
#MANAGER_POLL_INBOX_MS=8000
#MANAGER_SWEEP_MS=60000

# Events: forwarding of alerts and finished jobs, digest. Defaults shown (agent.*.job.finished is always heard).
#MANAGER_EVENT_POLL_MS=5000
#MANAGER_EVENT_TOPICS=grafana.alert.*,datadog.monitor.*,clock.nightly_digest.tick
#MANAGER_DIGEST_TOPICS=clock.nightly_digest.tick
#MANAGER_URGENT_TOPICS=grafana.alert.firing,datadog.monitor.alert
#MANAGER_EVENT_RATE_PER_HOUR=6
# Quiet hours hold non-urgent events and deliver them as one message afterwards:
#MANAGER_QUIET_HOURS=22:00-07:00
#MANAGER_QUIET_TZ=Europe/Stockholm

# Controls: event hub (for /sources, /pausesource) and the agents' health ports (for /handlers)
#MANAGER_HUB_URL=https://10.10.10.11:8445
#MANAGER_HUB_TOKEN_FILE=/home/js/.config/agent-cluster-telegram/hub-admin-token
#MANAGER_HUB_CA_FILE=/home/js/somework-pilot/pi-agent/config/ca.pem
#MANAGER_AGENT_HEALTH=agent/reviewer=http://10.10.10.11:8081
#MANAGER_AGENT_CA_FILE=

# Setup from Operations (ADR 0004). Defaults shown.
# The Manager's own endpoint for Operations to poll (/profile with the applied setup revision); port 0 switches it off.
#MANAGER_HEALTH_PORT=7080
#MANAGER_HEALTH_BIND=0.0.0.0
# Where the Manager keeps the last accepted documents and what it reports of them.
#MANAGER_SETUP_DIR=/home/js/.config/agent-cluster-telegram/setup
# Pi's agent folder on this host (the one the container mounts): mcp.json, skills/library and downloaded MCP servers go in it.
#MANAGER_PI_AGENT_DIR=/home/js/.pi/agent
# The same folder as the container sees it. `~/` is the container user's home; set the absolute path if the mount is elsewhere.
#MANAGER_PI_AGENT_DIR_IN_CONTAINER=/home/node/.pi/agent
# Operating system of the container, for the catalog's per-OS downloads of local MCP servers.
#MANAGER_PI_OS=linux
# MCP secrets: a catalog entry names the variables it needs; their values are read from here and reach Pi's container as environment
# variables by name. Document the names an operator may use; a document that names a secret that is not set here is rejected.
#GITHUB_MCP_TOKEN=
