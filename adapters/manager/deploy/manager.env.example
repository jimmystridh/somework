# ~/.config/agent-cluster-telegram/manager.env (mode 0600)
MANAGER_SOMEWORK_URL=https://10.0.0.5:8443
MANAGER_KEY_FILE=/home/js/somework-manager/keys/manager.key.json
MANAGER_CA_FILE=/home/js/somework-pilot/pi-agent/config/ca.pem
MANAGER_COMPOSE_FILES=/home/js/agent-cluster-pi/compose.pi.yaml,/home/js/somework-manager/adapters/manager/deploy/compose.manager.yaml

# The gateway listens on the gateway address of the Pi compose network (`docker network inspect agent-cluster-pi_default`), so only
# the host and containers on that network can reach it. The container gets the same address in its URL.
MANAGER_GATEWAY_BIND=172.18.0.1
MANAGER_GATEWAY_PORT=7079
MANAGER_GATEWAY_URL=http://172.18.0.1:7079

# Policy (defaults shown)
#MANAGER_MAX_TOKENS_CEILING=500000
#MANAGER_MAX_MINUTES_CEILING=60
#MANAGER_SUBMISSIONS_PER_HOUR=20
#MANAGER_MESSAGES_PER_HOUR=60
#MANAGER_APPROVAL_TTL_MINUTES=10

# Learning about changes: `wake` (NATS + HTTP safety net) or `polling` (short HTTP lookups only)
#MANAGER_FEED=wake
#MANAGER_POLL_TASK_MS=4000
#MANAGER_SWEEP_MS=60000
