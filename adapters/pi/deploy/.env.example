PI_VERSION=pilot-1
SOMEWORK_URL=https://10.0.0.5:8443
AGENT_KEY_DIR=/home/js/somework-pilot/pi-agent/keys
# credential-free smoke test: PI_PROVIDER=faux  PI_FAUX_PLAN=["write:smoke.txt:hello","final:done"]
PI_PROVIDER=openai-codex
# CODEX_PROXY_URL=http://PROXY_HOST:8095   # route the model through the fleet's codex-proxy (needs the agent's proxy key in secrets/pi/auth.json)
PI_MODEL=gpt-5.5
# models a job may pick with input.model (the default above is always allowed); every provider needs its entry in secrets/pi/auth.json
# PI_ALLOWED_MODELS=opencode-go/deepseek-v4-flash,antigravity/gemini-3.8-flash
# repository skills the agent may use, and the host directory with overlays that adjust them (both optional; unset = off)
# SKILLS_ALLOW=pr-review
# SKILLS_OVERLAY_DIR=/run/skills-overlay

# chat: every agent answers direct messages with the model (questions read-only; "instruct:" from the instructors runs a job). All optional.
# CHAT_MODE=notice                 # the fixed notice only, no model
# CHAT_ALLOWED_SENDERS=agent/manager,kind:human
# CHAT_INSTRUCTORS=agent/manager
# CHAT_REPOSITORY_URL=https://github.com/ORG/REPO   # what an instruction works on unless it names repo:
# CHAT_TOKEN_SHARE=0.1
