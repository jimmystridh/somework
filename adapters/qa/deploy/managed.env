# Settings that come with every deployment from the repository (the machine's own paths and secrets stay in agent.env; these override it).
# The verdict's comment, evidence and label are what the QA agent is for: they run without asking. Moving a ticket back to a developer still waits for the owner.
QA_JIRA_APPROVE=jira_transition_to_in_progress_and_reassign
# one verification takes about 30k tokens per browser step, because every step reads the whole conversation again: 2M allows about 60 steps
DAILY_TOKEN_LIMIT=10000000
BUDGET_MAX_TOKENS_CAP=2500000
# the QA skill's differences for this machine come with the repository (the base skill is read from the checkout)
SKILLS_OVERLAY_DIR=C:\somework\agent\adapters\qa\deploy\skills-overlay
