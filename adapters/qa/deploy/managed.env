# Settings that come with every deployment from the repository (the machine's own paths and secrets stay in agent.env; these override it).
# Every ticket write of the QA agent runs without asking: the verdict's comment, evidence and label, and the hand-back of a not-fixed ticket. `none` names no tool, so none waits.
QA_JIRA_APPROVE=none
# one verification takes about 30k tokens per browser step, because every step reads the whole conversation again: 4M allows about 90 steps
DAILY_TOKEN_LIMIT=20000000
BUDGET_MAX_TOKENS_CAP=5000000
# the QA skill's differences for this machine come with the repository (the base skill is read from the checkout)
SKILLS_OVERLAY_DIR=C:\somework\agent\adapters\qa\deploy\skills-overlay
# ffmpeg and ffprobe let QA look into the videos attached to tickets (frames, durations); the first entries are the kit's default PATH
WINDOWS_PATH_DIRS=C:\Program Files\Git\cmd;C:\Program Files\Git\usr\bin;C:\Program Files\Git\mingw64\bin;C:\Program Files\nodejs;C:\tools\ffmpeg;C:\Windows\System32;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Windows;C:\Windows\System32\Wbem
