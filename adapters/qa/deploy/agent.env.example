# agent.env: the settings of the QA service (KEY=VALUE, no quotes needed, # starts a comment). Copy to agent.env, edit, and pass it to
# install-service.ps1 -EnvFile. No secret belongs in this file: keys, tokens and certificates are files under C:\somework\secrets.

# --- SomeWork domain ---
SOMEWORK_URL=https://somework.example.test:8443
SOMEWORK_KEY_FILE=C:\somework\secrets\agent.key.json
SOMEWORK_CA_FILE=C:\somework\secrets\ca.pem
SOMEWORK_REQUIRE_TLS=1

# --- model: the service's OWN login, never shared with another agent (refresh tokens rotate) ---
PI_PROVIDER=openai-codex
PI_MODEL=gpt-5.5
PI_STATE_DIR=C:\somework\state
PI_AUTH_FILE=C:\somework\state\auth.json
# one verification at a time: the application under test, the browser and the ticket are per machine (the service refuses anything else)
PI_CONCURRENCY=1
BUDGET_MAX_TOKENS_CAP=1000000
BUDGET_MAX_MINUTES_CAP=60
DAILY_TOKEN_LIMIT=3000000

# --- git: read-only access to the repository under test. Optional for public repositories. Only ever sent to these hosts. ---
GIT_TOKEN_FILE=C:\somework\secrets\git-token
GIT_TOKEN_HOSTS=github.com
# A persistent bare mirror makes the workspace clone a local copy instead of a full download for every task (minutes for a large repository).
# The directory must be writable by the service account and on the data volume.
# GIT_MIRROR_DIR=C:/somework/workspaces/.mirrors
# GIT_MIRROR_REPOS=https://github.com/ORG/REPO.git
# GIT_MIRROR_REFRESH_MINUTES=30

# --- this role ---
WINDOWS_WORKSPACE_ROOT=C:/somework/workspaces
# After a timeout or abort, stop every process of this account that started during the command (the application, its children, Edge).
WINDOWS_SWEEP_USER=svc-qa
# WINDOWS_BASH=C:\Program Files\Git\bin\bash.exe
# WINDOWS_PATH_DIRS=C:\Program Files\Git\cmd;C:\Program Files\Git\usr\bin;C:\Program Files\nodejs;C:\Windows\System32;C:\Windows\System32\WindowsPowerShell\v1.0;C:\Windows
# WINDOWS_PASS_ENV=DOTNET_ROOT
QA_PROFILES_FILE=C:\somework\agent\profiles.json
# The ticket keys this agent handles; any other key is answered `skipped` without touching anything. Narrow it to your projects.
QA_TICKET_PATTERN=^PROJ-[0-9]+$
QA_BROWSER_CHANNEL=msedge
# The browser can only reach these hosts (the application's own addresses). Everything else is refused inside the browser.
QA_BROWSER_ALLOW_HOSTS=127.0.0.1,localhost

# --- ticket system (leave JIRA_URL out to run without one: the requester's scenario is then the only source and nothing is written) ---
# JIRA_URL=https://jira.example.test
# JIRA_PFX_FILE=C:\somework\secrets\jira-client.pfx
# JIRA_PFX_PASSWORD_FILE=C:\somework\secrets\jira-client.pfx.password
# JIRA_TOKEN_FILE=C:\somework\secrets\jira-token
# JIRA_CA_FILE=C:\somework\secrets\jira-ca.pem
# JIRA_TEST_STATUS=Test
# JIRA_IN_PROGRESS_STATUS=In Progress
# JIRA_VERIFIED_LABEL=AgentTested

# --- the repository's QA skill; the base text comes from the repository at the task's ref, the overlay states only the differences ---
SKILLS_ALLOW=qa
SKILLS_OVERLAY_DIR=C:\somework\agent\skills-overlay

HEALTH_PORT=8082
# Lets one reader (the fleet dashboard host) read /status, /ready and /profile: this machine's private address (never a wildcard), plus a firewall rule
# that allows only that host to the port. Without it the endpoint stays on loopback.
# WINDOWS_HEALTH_BIND=10.0.0.44
NODE_EXE=C:\Program Files\nodejs\node.exe

# conversations: every message is read by the model; a verification is a background job. All optional.
# CHAT_MODE=off                    # the agent takes no part in conversations
# APPROVERS=agent/manager,kind:human
# CHAT_REPOSITORY_URL=https://github.com/ORG/REPO   # the repository a verification works on when the event or the request names none
# CHAT_TOKEN_SHARE=0.1

# events: a ticket moving into JIRA_TEST_STATUS starts one verification (the handler is installed on the first start)
# QA_EVENT_APP=local
# QA_EVENT_CAP_PER_DAY=40
# QA_RESEED_HANDLER=1              # once, after changing JIRA_TEST_STATUS or the settings above

# Read-only logs and alerts for the agent itself (observe tools; packages/agent-kit/README.md). Needs the read-only Grafana route, the token and the CA in
# C:\somework\secrets (readable by the service account only) and the route's address in the firewall allow list.
# OBSERVE_ENABLED=1
# OBSERVE_SCOPE=own
# OBSERVE_OWN=host="<this machine's host label>",service_name="<role>"
# GRAFANA_URL=https://<observability VM private address>:9444
# GRAFANA_TOKEN_FILE=C:\somework\secrets\grafana-token
# GRAFANA_CA_FILE=C:\somework\secrets\grafana-ca.pem
