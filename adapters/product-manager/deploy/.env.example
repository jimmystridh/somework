PRODUCT_MANAGER_VERSION=pilot-1
# the developer role's sandbox image tag (the product manager reuses that image, see Dockerfile)
SANDBOX_VERSION=pilot-1
SOMEWORK_URL=https://domain.example.internal:8443
PRODUCT_MANAGER_KEY_DIR=/srv/somework-product-manager/keys
# credential-free smoke test: PI_PROVIDER=faux  PI_FAUX_PLAN='["final:hello"]'
PI_PROVIDER=openai-codex
# CODEX_PROXY_URL=http://PROXY_HOST:8095   # route the model through the fleet's codex-proxy (needs the agent's proxy key in secrets/pi/auth.json)
PI_MODEL=gpt-6.1-sol
# PI_ALLOWED_MODELS=
DAILY_TOKEN_LIMIT=2000000

# the repository the conversations read (its default branch is checked out read-only in the sandbox)
CHAT_REPOSITORY_URL=https://github.com/ORG/REPO
# who may approve a ticket: empty = every human. A request that comes from another agent needs a named approver (the owner's principal id)
# APPROVERS=kind:human,human/OWNER

# Plane: the product's one project, and the API key of this agent's own Plane user (a bot user that is a member of that project only)
# PLANE_BASE_URL=https://plane.example.internal
# PLANE_WORKSPACE_SLUG=WORKSPACE
# PLANE_PROJECT_ID=00000000-0000-0000-0000-000000000000
# PLANE_KEY_HOST=./secrets/plane-key
# PLANE_CA_HOST=./config/plane-ca.pem
# PLANE_LABELS=feature,bug,product-feedback   # these labels must exist in the project

# the agent's own Telegram bot (from BotFather) and the people allowed to write to it
# TELEGRAM_TOKEN_HOST=./secrets/telegram-bot-token
# TELEGRAM_ALLOWED_USER_IDS=123456789

# HEALTH_BIND=10.10.10.11   # interface for the health port (default 127.0.0.1); the dashboard reads it from there (port 8086)
