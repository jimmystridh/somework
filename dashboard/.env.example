# Environment of compose.yaml (copy to .env next to it; never commit the copy). Secrets are FILES in the secrets directory, never values here.

# --- the dashboard as before
FLEET_BIND=10.10.10.12                 # address of the services VM the gateway reaches
PVE_HOST=crazy-goldswine
PVE_ADDRESS=10.10.10.1
SOMEWORK_URL=https://10.10.10.14:8443  # the domain's TLS address
GRAFANA_URL=
METRICS_URL=

# --- Operations (ADR 0004). Leave DATABASE_URL_FILE empty to keep the console off.
DATABASE_URL_FILE=/run/secrets/database-url
#   file content: postgres://operations:<password>@10.10.10.13:5432/operations?sslmode=verify-full
#   the Postgres certificate must name that address (IP SAN) or host name; DATABASE_CA_FILE (default /run/secrets/postgres-ca.pem) is its CA
OIDC_ISSUER=https://login.microsoftonline.com/<tenant id>/v2.0
OIDC_CLIENT_ID=<application (client) id>
OIDC_REDIRECT_URL=https://<the address people open the dashboard on>/fleet/auth/callback
#   secrets directory: oidc-client-secret (the app registration's client secret), operations-session-key (>= 32 random characters),
#   operations-key.json (made on the host: docker run --rm -v /etc/agent-cluster-fleet:/out <image> /app/fleet-server --operations-keygen --domain <domain id> --out /out/operations-key.json)
OPERATIONS_FIRST_ADMIN=you@example.com
OPERATIONS_DOMAIN_ID=development

# --- Postgres on VM104 (deploy/postgres/compose.yaml)
POSTGRES_BIND=10.10.10.13
# POSTGRES_IMAGE=postgres:17.11-bookworm@sha256:3645570cccdfa447589da9f57dd740faa29b30938e861289a5574b6ca6b03826
