{
  "name": "somework",
  "private": true,
  "type": "module",
  "description": "SomeWork TypeScript workspace: the SDK, the shared agent runtime and the agent roles.",
  "workspaces": [
    "sdk/typescript",
    "packages/*",
    "adapters/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "check:roles": "node scripts/check-roles.ts",
    "test:scripts": "node --test scripts/*.test.ts"
  }
}
