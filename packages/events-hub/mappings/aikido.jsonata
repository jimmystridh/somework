/* Aikido Security webhook -> events. FIRST CUT: Aikido's payload shape is not known to us, so this mapping is deliberately defensive and
   never fails or drops. Whatever arrives becomes an event, so the first real delivery is visible:
     - topic aikido.issue.<change> when a field named type / event / event_type / action / kind holds a short value with a plain alphabet
       (letters, digits, _ . : -), lower-cased, other characters turned into _ ; otherwise aikido.event.received.
     - data carries only allow-listed scalar fields, looked up case-insensitively at the top level and one level down (issue, data,
       payload, event): type, severity, title (title / name / summary, 200 characters), issueId, repository, url (https only), plus
       `fields`, the names of the allow-listed fields that were found, and receivedAt. Nothing else is carried.
     - key = aikido:<id>:<change> when the payload has an id (id / event_id / issue_id / uuid), otherwise a hash of the payload. A payload
       with none of the allow-listed fields hashes together with receivedAt, so each unrecognised delivery is shown once.
   Refine this file when a real payload exists: see the README of this package ("Refining a mapping"). */
(
  $lc := function($o) { $type($o) = "object" ? $merge($each($o, function($v, $k) { { $lowercase($k): $v } })) : {} };
  $top := $lc(body);
  $all := $merge([$lc($top.issue), $lc($top.data), $lc($top.payload), $lc($top.event), $top]);
  $scalar := function($v) { $type($v) = "string" or $type($v) = "number" ? $string($v) };
  $get := function($names) { ($names.$scalar($lookup($all, $)))[$length($) > 0][0] };

  $typeRaw := $get(["type", "event", "event_type", "action", "kind"]);
  $typeOk := $typeRaw and $typeRaw ~> $match(/^[A-Za-z0-9_.:-]{1,40}$/);
  $change := $typeOk ? $replace($replace($lowercase($typeRaw), /[.:-]+/, "_"), /^issue_/, "");
  $changeOk := $change and $change ~> $match(/^[a-z0-9_]{1,40}$/);

  $severity := $clip($get(["severity", "severity_level", "priority"]), 20);
  $title := $clip($get(["title", "name", "summary"]), 200);
  $issueId := $clip($get(["issue_id", "issueid", "id", "event_id", "uuid"]), 100);
  $repoRaw := $all.repository ? $all.repository : $all.repo ? $all.repo : $all.repo_name ? $all.repo_name : $all.code_repo_name;
  $repoObj := $lc($repoRaw);
  $repository := $clip($type($repoRaw) = "object" ? $scalar($repoObj.full_name ? $repoObj.full_name : $repoObj.name) : $scalar($repoRaw), 200);
  $urlRaw := $get(["url", "html_url", "link", "issue_url"]);
  $url := $urlRaw and $urlRaw ~> $match(/^https:\/\/[^\s]{1,480}$/) ? $urlRaw;

  $fields := $append([], [$typeOk ? "type", $severity ? "severity", $title ? "title", $issueId ? "issueId", $repository ? "repository", $url ? "url"]);
  $id := $get(["id", "event_id", "issue_id", "uuid"]);
  $key := $id ? $clip("aikido:" & $id & ":" & ($changeOk ? $change : "event"), 200)
    : "aikido:h:" & $digest(body, $count($fields) = 0 ? receivedAt);

  {
    "topic": $changeOk ? "aikido.issue." & $change : "aikido.event.received",
    "key": $key,
    "data": $merge([
      { "receivedAt": receivedAt, "fields": $append([], $fields) },
      $typeOk ? { "type": $clip($typeRaw, 40) } : {},
      $severity ? { "severity": $severity } : {},
      $title ? { "title": $title } : {},
      $issueId ? { "issueId": $issueId } : {},
      $repository ? { "repository": $repository } : {},
      $url ? { "url": $url } : {}
    ])
  }
)
