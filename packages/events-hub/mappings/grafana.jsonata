/* Grafana alerting webhook (v1 payload) -> one event per alert. Shapes: rules/samples/ and docs/RULES.md (alert, uid, severity, summary, url).
   uid is the alert rule's uid, read from the generator URL (…/alerting/grafana/<uid>/view) or the __alert_rule_uid__ label. Key = rule uid +
   fingerprint + start (+ end once resolved), so Grafana resending a group notification is the same events. */
(
  $type(body.alerts) = "array" ? [body.alerts[[0..49]].(
    $resolved := status = "resolved";
    $uid := ($generatorURL := generatorURL; $generatorURL ~> $match(/\/alerting\/grafana\/([^\/?#]+)\/view/)).groups[0];
    $uid := $uid ? $uid : labels."__alert_rule_uid__";
    $start := $toMillis(startsAt);
    $end := $resolved and endsAt ? $toMillis(endsAt);
    $uid and fingerprint and $start ? {
      "topic": $resolved ? "grafana.alert.resolved" : "grafana.alert.firing",
      "key": "grafana:" & $uid & ":" & fingerprint & ":" & $floor($start / 1000) & ($end ? ":resolved:" & $floor($end / 1000) : ""),
      "data": {
        "alert": $clip(labels.alertname, 200),
        "uid": $clip($uid, 100),
        "severity": $clip(labels.severity, 50),
        "summary": $clip(annotations.summary, 300),
        "url": generatorURL
      }
    }
  )]
)
