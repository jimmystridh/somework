{
  "name": "@somework/agent-kit",
  "version": "0.1.0",
  "private": true,
  "description": "The shared runtime of SomeWork agents: Pi Durable runtime, sandbox, git workflow, budgets, approvals, skills. A role is a card, a profile and a main.ts.",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./credentials": "./src/credentials.ts",
    "./egress/proxy": "./src/egress/proxy.ts",
    "./git": "./src/git.ts",
    "./githost": "./src/githost.ts",
    "./handler": "./src/handler.ts",
    "./health": "./src/health.ts",
    "./ledger": "./src/ledger.ts",
    "./log": "./src/log.ts",
    "./metrics": "./src/metrics.ts",
    "./pi-runtime": "./src/pi-runtime.ts",
    "./policy": "./src/policy.ts",
    "./profile": "./src/profile.ts",
    "./providers": "./src/providers/index.ts",
    "./providers/allowlist": "./src/providers/allowlist.ts",
    "./providers/antigravity": "./src/providers/antigravity.ts",
    "./providers/faux": "./src/providers/faux.ts",
    "./runtime": "./src/runtime.ts",
    "./sandbox/remote-env": "./src/sandbox/remote-env.ts",
    "./sandbox/server": "./src/sandbox/server.ts",
    "./service": "./src/service.ts",
    "./shards": "./src/shards.ts",
    "./skills": "./src/skills.ts",
    "./testing": "./src/testing.ts",
    "./windows": "./src/windows/index.ts"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "sandbox": "node src/sandbox/main.ts",
    "egress": "node src/egress/main.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.0.3",
    "@earendil-works/pi-ai": "1.0.3",
    "@earendil-works/pi-durable": "1.0.3",
    "@somework/sdk": "0.1.0",
    "jiti": "2.7.0",
    "pi-antigravity": "0.9.0"
  }
}
