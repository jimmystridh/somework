    "defaults": {},
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Cost"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyUSD"
       },
       {
        "id": "decimals",
        "value": 3
       }
      ]
     },
     {
      "matcher": {
       "id": "byRegexp",
       "options": "Input|Output|Cache read|Cache write"
      },
      "properties": [
