{
 "uid": "llm-usage",
 "title": "LLM usage and cost",
 "tags": [
  "somework",
  "cost",
  "tokens"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": false,
 "refresh": "5m",
 "time": {
  "from": "now-7d",
  "to": "now"
 },
 "description": "Tokens by kind and cost in US dollars per agent, provider and model (somework_llm_* metrics from the kit agents), and the health of the fleet's hosts.",
 "templating": {
