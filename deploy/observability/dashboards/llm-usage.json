   {
    "name": "agent",
    "label": "Agent",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "cluster-prometheus"
    },
    "query": {
     "query": "label_values(somework_llm_cost_usd_total,agent)",
     "refId": "v"
    },
    "definition": "label_values(somework_llm_cost_usd_total,agent)",
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "provider",
    "label": "Provider",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "cluster-prometheus"
    },
    "query": {
     "query": "label_values(somework_llm_cost_usd_total{agent=~\"$agent\"},provider)",
     "refId": "v"
    },
    "definition": "label_values(somework_llm_cost_usd_total{agent=~\"$agent\"},provider)",
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
     "selected": true,
     "text": "All",
     "value": "$__all"
    },
    "sort": 1
   },
   {
    "name": "model",
    "label": "Model",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "cluster-prometheus"
    },
    "query": {
     "query": "label_values(somework_llm_cost_usd_total{agent=~\"$agent\",provider=~\"$provider\"},model)",
     "refId": "v"
    },
    "definition": "label_values(somework_llm_cost_usd_total{agent=~\"$agent\",provider=~\"$provider\"},model)",
    "refresh": 2,
    "includeAll": true,
    "allValue": ".*",
    "multi": true,
    "current": {
