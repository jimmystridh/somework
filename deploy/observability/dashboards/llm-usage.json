       "Value #B": "Input",
       "Value #C": "Output",
       "Value #D": "Cache read",
       "Value #E": "Cache write",
       "agent": "Agent",
       "provider": "Provider",
       "model": "Model"
      },
      "indexByName": {
       "agent": 0,
       "provider": 1,
       "model": 2,
       "Value #A": 3,
       "Value #B": 4,
       "Value #C": 5,
       "Value #D": 6,
       "Value #E": 7
      }
     }
    }
